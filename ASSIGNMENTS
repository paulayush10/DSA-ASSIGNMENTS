QUESTION 5
FACTORIAL USING RECURSION AND ITERATION
============================================================

#include <stdio.h>

int factorialRec(int n) {
    if (n == 0 || n == 1) {
        return 1;
    }

    return n * factorialRec(n - 1);
}

int factorialItr(int n) {
    int fact = 1;

    for (int i = 1; i <= n; i++) {
        fact = fact * i;
    }

    return fact;
}

int main() {
    int a = 5;

    printf("Factorial using Iteration = %d\n", factorialItr(a));
    printf("Factorial using Recursion = %d\n", factorialRec(a));

    return 0;
}

OUTPUT:
Factorial using Iteration = 120
Factorial using Recursion = 120


