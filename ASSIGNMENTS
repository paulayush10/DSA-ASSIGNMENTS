#include <stdio.h>

void bubbleSort(int array[], int size) {
    int step, i;

    for (step = 0; step < size - 1; step++) {

        for (i = 0; i < size - step - 1; i++) {

            if (array[i] > array[i + 1]) {
                int temp = array[i];

                array[i] = array[i + 1];
                array[i + 1] = temp;
            }
