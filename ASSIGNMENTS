QUESTION 11
BINARY SEARCH (ITERATIVE) USING FUNCTION
============================================================

#include <stdio.h>

int binarySearch(int arr[], int size, int key) {
    int low = 0;
    int high = size - 1;

    while (low <= high) {
        int mid = low + (high - low) / 2;

        if (arr[mid] == key) {
            return mid;
        }
        else if (arr[mid] < key) {
            low = mid + 1;
        }
        else {
            high = mid - 1;
        }
    }

    return -1;
}

int main() {
    int arr[] = {10, 20, 30, 40, 50};
    int size = 5;
    int key = 40;

    int result = binarySearch(arr, size, key);

    if (result != -1) {
        printf("Found %d at index %d.\n", key, result);
    }
    else {
        printf("%d not found.\n", key);
    }

    return 0;
}

