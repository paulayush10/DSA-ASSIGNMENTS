#include <stdio.h>

#define SIZE 5

int queue[SIZE];
int front = -1;
int rear = -1;

void enqueue(int value) {

    if (rear == SIZE - 1) {
        printf("Queue is Full\n");
    }
    else {

        if (front == -1) {
            front = 0;
        }

        rear++;
        queue[rear] = value;

        printf("%d inserted into queue\n", value);
    }
}

void dequeue() {

    if (front == -1 || front > rear) {
        printf("Queue is Empty\n");
    }
    else {
        printf("%d deleted from queue\n", queue[front]);
        front++;
    }
}

void displayQueue() {

    if (front == -1 || front > rear) {
        printf("Queue is Empty\n");
    }
    else {

        printf("Queue: ");

        for (int i = front; i <= rear; i++) {
            printf("%d ", queue[i]);
        }

        printf("\n");
    }
}

int main() {

    enqueue(10);
    enqueue(20);
    enqueue(30);

    displayQueue();

    dequeue();

    displayQueue();

    return 0;
}

OUTPUT:
10 inserted into queue
20 inserted into queue
30 inserted into queue
Queue: 10 20 30
10 deleted from queue
Queue: 20 30
